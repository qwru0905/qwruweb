{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./worker/index.ts",
  "name": "qwruweb",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "qwruweb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "qwruweb-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SEEN",
      "id": "7c9fcfbd45784dd0ad88959bd73fda0c",
      "remote": false
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qwruwebdb",
      "database_id": "04f588cd-a184-4e0e-861c-add0a241de47",
      "remote": false
    }
  ]
}
